        <addForeignKeyConstraint baseColumnNames="slot_capacity_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__slot_capacity_id"
                                 referencedColumnNames="id"
                                 referencedTableName="slot_capacity"
                                 />
    </changeSet>
</databaseChangeLog>

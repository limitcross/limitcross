                                 constraintName="fk_booking__customer_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />

        <addForeignKeyConstraint baseColumnNames="service_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__service_id"
                                 referencedColumnNames="id"

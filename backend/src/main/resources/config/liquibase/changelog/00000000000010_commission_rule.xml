<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="00000000000010" author="limitcross">
        <createTable tableName="commission_rule">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_id" type="varchar(50)"/>
            <column name="category_id" type="bigint"/>
            <column name="city_id" type="bigint"/>
            <column name="tier_id" type="bigint"/>
            <column name="commission_percent" type="decimal(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="flat_fee" type="decimal(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="valid_to" type="timestamp"/>
        </createTable>
        <createIndex tableName="commission_rule" indexName="ix_comm_lookup">
            <column name="service_id"/>
            <column name="category_id"/>
            <column name="city_id"/>
            <column name="tier_id"/>
        </createIndex>
        <addForeignKeyConstraint
            baseTableName="commission_rule"
            baseColumnNames="service_id"
            constraintName="fk_comm_facility_service"
            referencedTableName="facility_service"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="commission_rule"
            baseColumnNames="tier_id"
            constraintName="fk_comm_professional_tier"
            referencedTableName="professional_tier"
            referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
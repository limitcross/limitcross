                                 />

        <addForeignKeyConstraint baseColumnNames="address_id"
                                 baseTableName="booking_subscription"
                                 constraintName="fk_booking_subscription__address_id"
                                 referencedColumnNames="id"
                                 referencedTableName="customer_address"
                                 />

        <addForeignKeyConstraint baseColumnNames="preferred_professional_id"

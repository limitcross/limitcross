rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/bookings/{bookingId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.status == 'requested'
        && request.resource.data.date is timestamp
        && request.resource.data.date > request.time
        && request.resource.data.serviceId is string
        && request.resource.data.timeSlot is string
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 8;
      allow update: if isOwner(userId)
        && resource.data.status in ['requested', 'confirmed']
        && (
          (request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']))
          ||
          (request.resource.data.status == resource.data.status
            && request.resource.data.date is timestamp
            && request.resource.data.date > request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['date', 'timeSlot', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /app_credentials/{appName} {
      allow read, create, update, delete: if isVerifiedUser();
    }
  }

  function isOwner(userId) {
    return isVerifiedUser() && request.auth.uid == userId;
  }

  function isVerifiedUser() {
    return request.auth != null
      && (
        request.auth.token.firebase.sign_in_provider == 'phone'
        || request.auth.token.email_verified == true
      );
  }
}
